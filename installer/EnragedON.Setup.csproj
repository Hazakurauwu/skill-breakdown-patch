<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EnragedON.Setup</RootNamespace>
    <AssemblyName>EnragedON-Setup</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Version info shown in the file's Properties > Details tab. A plain, honest
         identity (no packer, no obfuscation) is part of what keeps antivirus calm. -->
    <Version>1.6.0</Version>
    <FileVersion>1.6.0.0</FileVersion>
    <AssemblyTitle>EnragedON Setup</AssemblyTitle>
    <Product>EnragedON Skill Breakdown Patch</Product>
    <Company>EnragedON</Company>
    <Copyright>EnragedON</Copyright>
    <Description>Installs the EnragedON Skill Breakdown patch into ShinraMeter.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- One framework-dependent exe, no runtime bundled. -->
    <!-- Targets .NET 7 on purpose: the ShinraMeter that ships with TeraToolbox runs on the
         .NET 7 Desktop runtime, the Classic+ one on 8. Building for 7 plus LatestMajor roll
         forward means the exe starts on whichever of those (or newer) the player has, instead
         of Windows asking them to download a runtime before the installer even opens. -->
    <RollForward>LatestMajor</RollForward>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- SetupTests is its own project living in a subfolder. Without these removes, this
         project's default globs swallow its sources and its obj/ folder, and the build dies
         with "Duplicate AssemblyTitleAttribute" and friends. -->
    <Compile Remove="SetupTests\**" />
    <Page Remove="SetupTests\**" />
    <None Remove="SetupTests\**" />
    <Resource Remove="SetupTests\**" />
    <EmbeddedResource Remove="SetupTests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The prebuilt patch DLLs travel inside the exe. -->
    <EmbeddedResource Include="..\release\DamageMeter.dll" LogicalName="payload.toolbox.dll" />
    <EmbeddedResource Include="..\release\DamageMeter.classicplus.dll" LogicalName="payload.classicplus.dll" />
  </ItemGroup>

</Project>
