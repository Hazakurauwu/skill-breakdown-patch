<Window x:Class="EnragedON.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:EnragedON.Setup.Core"
        xmlns:local="clr-namespace:EnragedON.Setup"
        Title="EnragedON Setup" Width="800" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Inter}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        Icon="pack://application:,,,/Assets/app.ico">

  <Window.Resources>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,14,0,4"/>
    </Style>
    <Style x:Key="Lead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="LineHeight" Value="19.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- meter card -->
    <DataTemplate x:Key="MeterCard" DataType="{x:Type local:MeterVM}">
      <Grid Margin="0,0,0,9" Background="Transparent">
        <Grid.Triggers>
          <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            </Storyboard></BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
            </Storyboard></BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
        <Border CornerRadius="14" BorderThickness="1" Background="#B816181F" BorderBrush="#0FFFFFFF"/>
        <Border x:Name="hover" CornerRadius="14" BorderThickness="1" Background="#CC1C1E27" BorderBrush="#73C8171D" Opacity="0"/>
        <Grid Margin="14,13">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="42" Height="42" CornerRadius="11" Background="{Binding IconBrush}" VerticalAlignment="Center">
            <TextBlock Text="{Binding IconText}" FontSize="13" FontWeight="ExtraBold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <WrapPanel>
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Border CornerRadius="9" Padding="8,3" Background="{Binding PillBg}" VerticalAlignment="Center">
                <TextBlock Text="{Binding PillText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding PillFg}"/>
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding ShortPath}" ToolTip="{Binding FullPath}" FontFamily="{StaticResource Mono}" FontSize="11"
                       Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Button Style="{StaticResource BtnGhost}" Content="{x:Static core:L.BtnUninstall}" Click="OnUninstallClick"
                    Visibility="{Binding UninstallVisibility}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource BtnPri}" Content="{Binding ActionText}" Click="OnActionClick"
                    Visibility="{Binding PriVisibility}"/>
            <Button Style="{StaticResource BtnSec}" Content="{Binding ActionText}" Click="OnActionClick"
                    Visibility="{Binding SecVisibility}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </DataTemplate>

    <!-- progress step -->
    <DataTemplate x:Key="StepRow" DataType="{x:Type local:StepVM}">
      <Border x:Name="row" CornerRadius="10" Padding="12,10" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,4">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="22" Height="22">
            <Ellipse x:Name="pend" Stroke="{StaticResource Border2}" StrokeThickness="1.5"/>
            <Grid x:Name="done" Visibility="Collapsed">
              <Ellipse Fill="#2457F287" Stroke="#8057F287" StrokeThickness="1.5"/>
              <Path Data="M 7,11.5 L 9.8,14.2 L 15.2,8.2" Stroke="{StaticResource Green}" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <ContentControl x:Name="spin" Style="{StaticResource Spinner}" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="label" Grid.Column="1" Text="{Binding Text}" FontSize="13.5" Foreground="{StaticResource Text3}"
                     Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Text3}"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Done">
          <Setter TargetName="pend" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="done" Property="Visibility" Value="Visible"/>
          <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text2}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Active">
          <Setter TargetName="pend" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="spin" Property="Visibility" Value="Visible"/>
          <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text}"/>
          <Setter TargetName="row" Property="Background" Value="#14C8171D"/>
          <Setter TargetName="row" Property="BorderBrush" Value="#38C8171D"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="40,20,40,60">
    <!-- drop shadow -->
    <Border CornerRadius="14" Background="#0D0E12">
      <Border.Effect>
        <DropShadowEffect BlurRadius="70" ShadowDepth="26" Direction="270" Opacity=".6" Color="Black"/>
      </Border.Effect>
    </Border>

    <Grid x:Name="Win" Width="720" Height="500">
      <Grid.Clip>
        <RectangleGeometry Rect="0,0,720,500" RadiusX="14" RadiusY="14"/>
      </Grid.Clip>

      <!-- ember background -->
      <Rectangle Fill="{StaticResource Bg}"/>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1.2" RadiusY=".9">
            <GradientStop Offset="0" Color="#29C8171D"/>
            <GradientStop Offset=".55" Color="#00C8171D"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX=".9" RadiusY=".7">
            <GradientStop Offset="0" Color="#12C8171D"/>
            <GradientStop Offset=".6" Color="#00C8171D"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Background="Transparent" MouseLeftButtonDown="OnTitleDrag">
          <TextBlock Text="{x:Static core:L.WindowTitle}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Text3}"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
            <Button Style="{StaticResource TitleBtn}" Click="OnMinimize" FontFamily="{StaticResource Inter}">&#x2013;</Button>
            <Button x:Name="CloseBtn" Style="{StaticResource TitleCloseBtn}" Click="OnCloseWindow" FontFamily="Segoe UI Symbol">&#x2715;</Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

          <!-- ================= 1 · HOME ================= -->
          <Grid x:Name="ScreenHome">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HomeBody" Margin="30,4,30,12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <ContentControl x:Name="HomeBrand"/>
              <TextBlock Grid.Row="1" Style="{StaticResource H2}" Text="{x:Static core:L.HomeTitle}"/>
              <TextBlock x:Name="HomeLead" Grid.Row="2" Style="{StaticResource Lead}" Text="{x:Static core:L.HomeLead}"/>

              <StackPanel Grid.Row="3" VerticalAlignment="Top">
                <ScrollViewer MaxHeight="238" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="MeterList" ItemTemplate="{StaticResource MeterCard}"/>
                </ScrollViewer>
                <StackPanel x:Name="AddRow" Orientation="Horizontal" Margin="0,1,0,0">
                  <Button x:Name="AddLink" Style="{StaticResource BtnLink}" FontSize="12" Content="{x:Static core:L.AddManual}" Click="OnPickFolder"/>
                  <TextBlock x:Name="PickError" FontSize="12" Foreground="{StaticResource Red2}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                             Text="{x:Static core:L.NotFoundInFolder}"/>
                </StackPanel>
              </StackPanel>

              <!-- scanning -->
              <Grid x:Name="ScanPanel" Grid.Row="3" VerticalAlignment="Top" Visibility="Collapsed">
                <Border CornerRadius="14" BorderThickness="1" Background="#B816181F" BorderBrush="#0FFFFFFF" Height="70">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Spinner}"/>
                    <TextBlock Text="{x:Static core:L.Scanning}" FontSize="13" Foreground="{StaticResource Text2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- nothing found -->
              <Grid x:Name="EmptyPanel" Grid.Row="3" VerticalAlignment="Top" Visibility="Collapsed">
                <Border CornerRadius="14" BorderThickness="1" Background="#B816181F" BorderBrush="#0FFFFFFF" Padding="14,13">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource Bg4}">
                      <TextBlock Text="?" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{x:Static core:L.NothingCard}" FontSize="14" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource BtnPri}" Content="{x:Static core:L.ChooseFolder}" Click="OnPickFolder"/>
                  </Grid>
                </Border>
              </Grid>

            </Grid>
            <ContentControl x:Name="HomeFoot" Grid.Row="1"/>

            <!-- uninstall confirmation -->
            <Grid x:Name="UninstallDialog" Grid.RowSpan="2" Visibility="Collapsed" Background="#A8050609">
              <Grid Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="16" Background="Black" Margin="0,10,0,-10" Opacity=".55">
                  <Border.Effect><BlurEffect Radius="50"/></Border.Effect>
                </Border>
                <Border CornerRadius="16" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border2}" BorderThickness="1" Padding="22">
                  <StackPanel>
                    <TextBlock x:Name="DlgTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{x:Static core:L.UninstallDlgBody}" FontSize="13" Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="19.5" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Style="{StaticResource BtnSec}" Content="{x:Static core:L.KeepIt}" Click="OnDialogKeep" Margin="0,0,10,0"/>
                      <Button Style="{StaticResource BtnPri}" Content="{x:Static core:L.BtnUninstall}" Click="OnDialogUninstall"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </Grid>

          <!-- ================= 2 · CLOSE THE GAME ================= -->
          <Grid x:Name="ScreenClose" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,30,10">
              <Grid Width="74" Height="74" Margin="0,0,0,16">
                <Ellipse StrokeThickness="1" Stroke="#59FAA61A">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Offset="0" Color="#2EFAA61A"/>
                      <GradientStop Offset="1" Color="#0AFAA61A"/>
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Viewbox Width="34" Height="34">
                  <Canvas Width="24" Height="24">
                    <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19" Stroke="{StaticResource Gold}" StrokeThickness="2.2"/>
                    <Path Data="M 12,8 L 12,13" Stroke="{StaticResource Gold}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Canvas.Left="10.9" Canvas.Top="15.4" Width="2.2" Height="2.2" Fill="{StaticResource Gold}"/>
                  </Canvas>
                </Viewbox>
              </Grid>
              <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4" HorizontalAlignment="Center" Text="{x:Static core:L.CloseTitle}"/>
              <TextBlock Style="{StaticResource Lead}" MaxWidth="420" TextAlignment="Center" HorizontalAlignment="Center" Text="{x:Static core:L.CloseLead}"/>
              <ItemsControl x:Name="ProcList" HorizontalAlignment="Center" Margin="0,14,0,20">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="14" Background="{StaticResource Bg3}" BorderBrush="{StaticResource Border1}" BorderThickness="1" Padding="12,6" Margin="4,0">
                      <StackPanel Orientation="Horizontal">
                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                          <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                              <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To=".45" Duration="0:0:0.7"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                              </Storyboard></BeginStoryboard>
                            </EventTrigger>
                          </Grid.Triggers>
                          <Ellipse Fill="#33E8404A"/>
                          <Ellipse Width="7" Height="7" Fill="{StaticResource Red2}"/>
                        </Grid>
                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Text2}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource BtnSec}" HorizontalAlignment="Center" Content="{x:Static core:L.Cancel}" Click="OnCancelWait"/>
              <TextBlock FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" Margin="0,10,0,0" Text="{x:Static core:L.Waiting}"/>
            </StackPanel>
          </Grid>

          <!-- ================= 3 · PROGRESS ================= -->
          <Grid x:Name="ScreenProgress" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="30,4,30,12">
              <ContentControl x:Name="ProgressBrand"/>
              <TextBlock x:Name="ProgressTitle" Style="{StaticResource H2}"/>
              <Grid x:Name="BarTrack" Height="6" Margin="0,16,0,4">
                <Border CornerRadius="3" Background="{StaticResource Bg3}"/>
                <Grid x:Name="BarFill" HorizontalAlignment="Left" Width="0">
                  <Border CornerRadius="3" Background="#E8404A" Opacity=".5" Margin="0,-2">
                    <Border.Effect><BlurEffect Radius="10"/></Border.Effect>
                  </Border>
                  <Border CornerRadius="3">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#C8171D"/>
                        <GradientStop Offset="1" Color="#E8404A"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                </Grid>
              </Grid>
              <ItemsControl x:Name="StepList" Margin="0,6,0,0" ItemTemplate="{StaticResource StepRow}"/>
            </StackPanel>
            <Border Grid.Row="1" Height="54" BorderThickness="0,1,0,0" BorderBrush="#0DFFFFFF" Padding="30,0">
              <TextBlock Text="{x:Static core:L.DontOpenGame}" FontSize="11.5" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Border>
          </Grid>

          <!-- ================= 4 · RESULT (done / removed / error) ================= -->
          <Grid x:Name="ScreenResult" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,30,10">
              <Grid Width="74" Height="74" Margin="0,0,0,16">
                <Ellipse x:Name="OkGlow" Fill="#57F287" Opacity=".16" Margin="-10">
                  <Ellipse.Effect><BlurEffect Radius="34"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="ResultRing" StrokeThickness="1"/>
                <Viewbox x:Name="OkIcon" Width="34" Height="34">
                  <Path Data="M 5,12.5 L 9.5,17 L 19,7.5" Stroke="{StaticResource Green}" StrokeThickness="2.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                </Viewbox>
                <Viewbox x:Name="ErrIcon" Width="30" Height="30" Visibility="Collapsed">
                  <Path Data="M 7,7 L 17,17 M 17,7 L 7,17" Stroke="{StaticResource Red2}" StrokeThickness="2.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                </Viewbox>
              </Grid>
              <TextBlock x:Name="ResultTitle" Style="{StaticResource H2}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ResultLead" Style="{StaticResource Lead}" MaxWidth="440" TextAlignment="Center" HorizontalAlignment="Center"/>

              <StackPanel x:Name="NewsPanel" Width="420" Margin="0,4,0,22">
                <Border CornerRadius="11" Background="#9916181F" BorderBrush="#0DFFFFFF" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="+" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource Red2}"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="19.5">
                      <Run Text="{x:Static core:L.New1Bold}" FontWeight="Bold" Foreground="{StaticResource Text}"/><Run Text="{x:Static core:L.New1Rest}"/>
                    </TextBlock>
                  </Grid>
                </Border>
                <Border CornerRadius="11" Background="#9916181F" BorderBrush="#0DFFFFFF" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="+" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource Red2}"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="19.5">
                      <Run Text="{x:Static core:L.New2Bold}" FontWeight="Bold" Foreground="{StaticResource Text}"/><Run Text="{x:Static core:L.New2Rest}"/>
                    </TextBlock>
                  </Grid>
                </Border>
                <Border CornerRadius="11" Background="#9916181F" BorderBrush="#0DFFFFFF" BorderThickness="1" Padding="12,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="+" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource Red2}"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="19.5">
                      <Run Text="{x:Static core:L.New3Bold}" FontWeight="Bold" Foreground="{StaticResource Text}"/><Run Text="{x:Static core:L.New3Rest}"/>
                    </TextBlock>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="ResultSecBtn" Style="{StaticResource BtnSecBig}" Click="OnResultSecondary" Margin="0,0,10,0"/>
                <Button x:Name="ResultPriBtn" Style="{StaticResource BtnPriBig}" Click="OnResultPrimary"/>
              </StackPanel>
            </StackPanel>
          </Grid>

        </Grid>
      </Grid>

      <!-- window outline -->
      <Border CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource Border1}" IsHitTestVisible="False"/>
    </Grid>
  </Grid>
</Window>
