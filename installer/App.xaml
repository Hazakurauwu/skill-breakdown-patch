<Application x:Class="EnragedON.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>

      <!-- ===== fonts (same families as enragedon.com) ===== -->
      <FontFamily x:Key="Inter">pack://application:,,,/Assets/Fonts/#Inter, Segoe UI</FontFamily>
      <FontFamily x:Key="Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono, Consolas</FontFamily>
      <FontFamily x:Key="Cinzel">pack://application:,,,/Assets/Fonts/#Cinzel Decorative, Georgia</FontFamily>

      <!-- ===== site palette ===== -->
      <SolidColorBrush x:Key="Bg" Color="#0D0E12"/>
      <SolidColorBrush x:Key="Bg2" Color="#13151B"/>
      <SolidColorBrush x:Key="Bg3" Color="#191C24"/>
      <SolidColorBrush x:Key="Bg4" Color="#222533"/>
      <SolidColorBrush x:Key="Border1" Color="#2A2D3A"/>
      <SolidColorBrush x:Key="Border2" Color="#353848"/>
      <SolidColorBrush x:Key="Text" Color="#E3E5E8"/>
      <SolidColorBrush x:Key="Text2" Color="#C0C4CC"/>
      <SolidColorBrush x:Key="Text3" Color="#8B909A"/>
      <SolidColorBrush x:Key="Red" Color="#C8171D"/>
      <SolidColorBrush x:Key="Red2" Color="#E8404A"/>
      <SolidColorBrush x:Key="Green" Color="#57F287"/>
      <SolidColorBrush x:Key="Gold" Color="#FAA61A"/>
      <LinearGradientBrush x:Key="RedGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E8404A"/>
        <GradientStop Offset="1" Color="#C8171D"/>
      </LinearGradientBrush>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
      </Style>

      <!-- ===== buttons ===== -->
      <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
        <Setter Property="Tag">
          <Setter.Value><CornerRadius>10</CornerRadius></Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="RenderTransform">
              <Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value>
            </Setter>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value=".45"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- primary: brand red gradient + red glow -->
      <Style x:Key="BtnPri" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border Background="#C8171D" Opacity=".42" Margin="4,8,4,-4"
                        CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border.Effect><BlurEffect Radius="16"/></Border.Effect>
                </Border>
                <Border Background="{StaticResource RedGrad}"
                        CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Border x:Name="hl" Background="White" Opacity="0"
                        CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="hl" Property="Opacity" Value=".08"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- secondary: dark fill, subtle border -->
      <Style x:Key="BtnSec" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{StaticResource Bg3}" BorderBrush="{StaticResource Border2}" BorderThickness="1"
                      CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="BorderBrush" Value="#4A4E61"/>
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ghost: text only -->
      <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="BtnPriBig" TargetType="Button" BasedOn="{StaticResource BtnPri}">
        <Setter Property="Padding" Value="26,12"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Tag"><Setter.Value><CornerRadius>12</CornerRadius></Setter.Value></Setter>
      </Style>
      <Style x:Key="BtnSecBig" TargetType="Button" BasedOn="{StaticResource BtnSec}">
        <Setter Property="Padding" Value="26,12"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Tag"><Setter.Value><CornerRadius>12</CornerRadius></Setter.Value></Setter>
      </Style>

      <!-- plain text link -->
      <Style x:Key="BtnLink" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" Padding="0,4">
                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- title bar buttons -->
      <Style x:Key="TitleBtn" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg4}"/>
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value=".35"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TitleCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value=".35"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- slim scrollbar -->
      <Style x:Key="SlimThumb" TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Border Background="{StaticResource Border2}" CornerRadius="3"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource SlimThumb}"/></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- spinning arc (active step / scanning) -->
      <Style x:Key="Spinner" TargetType="ContentControl">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ContentControl">
              <Path Stroke="{StaticResource Red2}" StrokeThickness="1.5" Data="M 18.25,3.75 A 10.25,10.25 0 1 1 3.75,3.75"
                    RenderTransformOrigin=".5,.5" Width="22" Height="22">
                <Path.RenderTransform><RotateTransform x:Name="rot"/></Path.RenderTransform>
                <Path.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Path.Triggers>
              </Path>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
