<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Must match the .NET version the target meter runs on: the merged IL keeps the helper's
         framework references, and a net8 reference crashes a net7 meter at the end of the
         first fight (FileNotFoundException System.Runtime 8.0.0.0, shipped by mistake in v1.6).
         build-patch.ps1 passes the right value, read from the meter's runtimeconfig. -->
    <HelperTfm Condition="'$(HelperTfm)' == ''">net8.0-windows</HelperTfm>
    <TargetFramework>$(HelperTfm)</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AssemblyName>ShinraRotationPatch</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\RotationEnricher.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DamageMeter">
      <HintPath>..\work\DamageMeter.p1.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Data">
      <HintPath>..\libs\Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tera.Core">
      <HintPath>..\libs\Tera.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
